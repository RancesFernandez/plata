rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPlanMember(planId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/plans/$(planId)).data.memberUids;
    }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /transactions/{id} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.planId != null && isPlanMember(resource.data.planId))
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.planId == null || isPlanMember(request.resource.data.planId));
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && (request.resource.data.planId == null || isPlanMember(request.resource.data.planId));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /budgets/{id} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.planId != null && isPlanMember(resource.data.planId))
      );
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.limit is number
        && request.resource.data.limit > 0
        && request.resource.data.period is string
        && (request.resource.data.planId == null || isPlanMember(request.resource.data.planId));
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.limit is number
        && request.resource.data.limit > 0
        && (request.resource.data.planId == null || isPlanMember(request.resource.data.planId));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /goals/{id} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.planId != null && isPlanMember(resource.data.planId))
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.planId == null || isPlanMember(request.resource.data.planId));
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && (request.resource.data.planId == null || isPlanMember(request.resource.data.planId));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /plans/{id} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.token.email in resource.data.pendingInviteEmails
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        (
          request.auth.token.email in resource.data.pendingInviteEmails &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.auth.uid in request.resource.data.memberUids &&
          request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
          request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
          request.resource.data.memberEmails.hasAll(resource.data.memberEmails) &&
          request.resource.data.memberEmails.size() == resource.data.memberEmails.size() + 1 &&
          request.auth.token.email in request.resource.data.memberEmails &&
          !(request.auth.token.email in request.resource.data.pendingInviteEmails) &&
          request.resource.data.pendingInviteEmails.size() == resource.data.pendingInviteEmails.size() - 1
        )
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /invitations/{id} {
      allow create: if signedIn() && request.resource.data.inviterUid == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.inviterUid == request.auth.uid ||
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.inviteeEmail == request.auth.token.email
      );
      allow update: if signedIn() && (
        resource.data.inviterUid == request.auth.uid ||
        (resource.data.inviteeEmail == request.auth.token.email &&
         request.resource.data.inviteeUid == request.auth.uid &&
         request.resource.data.status == 'accepted')
      );
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }
  }
}
